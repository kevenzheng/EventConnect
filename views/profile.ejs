<!DOCTYPE html>
<html>
<head>
    <title>User Profile - EventConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>
        <div class="nav-buttons">
            <a href="/" class="nav-btn">Home</a>
            <a href="/dashboard" class="nav-btn">Dashboard</a>
            <a href="/jobs">View Jobs</a>
            <% if (user.role === 'admin') { %>
                <a href="/jobs/add">Create Job</a>
            <% } %>
            <% if (user.role === 'user') { %>
                <a href="/applications">My Applications</a>
            <% } else if (user.role === 'admin') { %>
                <a href="/applications/manage">Manage Applications</a>
            <% } %>
            <% if (user && user.role === 'user') { %>
                <a href="/favourites" class="nav-btn active-btn">My Favourites</a>
            <% } %>
            <a href="/profile" class="nav-btn active-btn">My Profile</a>
            <% if (user && user.role === 'admin') { %>
            <a href="/profile/management" class="nav-btn">View Management</a>
            <% } %>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>
    </nav>

    <div class="dashboard-container">
        <div class="dashboard-card">
            <h1><%= profileUser.username %>'s Profile</h1>
            <p><strong>Account Role:</strong> <%= profileUser.role === 'admin' ? 'Employer (Admin)' : 'Employee' %></p>
            <p><strong>Email:</strong> <%= profileUser.email %></p>
            <p><strong>Contact:</strong> <%= profileUser.contact %></p>
        </div>

        <div class="dashboard-card">
            <h3>Average Performance Rating</h3>
            <% if (avgRating) { %>
                <h2 style="color: #f39c12; margin: 5px 0;"><%= avgRating %> / 5.0 ★</h2>
                <p>Based on <%= reviewCount %> review(s)</p>
            <% } else { %>
                <p>No ratings or feedback recorded yet.</p>
            <% } %>
        </div>

        <div class="dashboard-card">
            <h3>Feedback & Reviews Received</h3>
            <% if (reviews && reviews.length > 0) { %>
                <% reviews.forEach(function(r) { %>
                    <div class="review-card">
                        <p class="star-rating"><%= r.rating %> / 5 ★ <small>for <strong><%= r.job_title %></strong></small></p>
                        <p> "<%= r.review_text %>"</p>
                        <small style="color: #777;">&mdash; Posted by <%= r.reviewer_name %></small>
                    </div>
                <% }); %>
            <% } else { %>
                <p>No written reviews available.</p>
            <% } %>
        </div>
    </div>

</body>
</html>