<!DOCTYPE html>
<html>
<head>
    <title>My Applications - EventConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>

        <div class="nav-buttons">
            <a href="/">Home</a>
            <a href="/dashboard">Dashboard</a>
            <a href="/jobs">View Jobs</a>
            <% if (user.role === 'admin') { %>
                <a href="/jobs/add">Create Job</a>
            <% } %>
            <% if (user.role === 'user') { %>
                <a href="/applications">My Applications</a>
            <% } else if (user.role === 'admin') { %>
                <a href="/applications/manage">Manage Applications</a>
            <% } %>
            <% if (user && user.role === 'user') { %>
                <a href="/favourites" class="nav-btn active-btn">My Favourites</a>
            <% } %>
            <a href="/profile" class="nav-btn active-btn">My Profile</a>
            <% if (user && user.role === 'admin') { %>
            <a href="/profile/management" class="nav-btn">View Management</a>
            <% } %>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>
    </nav>

    <div class="dashboard-container">
        <h1>My Applications</h1>

        <p>Here are all the jobs you have applied for and their current status.</p>

        <% if (messages && messages.length > 0) { %>
            <div class="success"><%= messages[0] %></div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
            <div class="error"><%= errors[0] %></div>
        <% } %>

        <% if (applications.length === 0) { %>
            <div class="dashboard-card">
                <p>You haven't applied for any jobs yet.</p>
                <a href="/jobs" class="btn btn-primary">Browse Jobs</a>
            </div>
        <% } %>

        <div class="card-grid">
            <% applications.forEach(function(app) { %>
                <div class="dashboard-card">
                    <h3><%= app.job_title %> &mdash; <%= app.event_name %></h3>

                    <p><strong>Location:</strong> <%= app.location %></p>
                    <p><strong>Event Date:</strong> <%= new Date(app.event_date).toISOString().split('T')[0] %></p>
                    <p><strong>Applied On:</strong> <%= new Date(app.applied_at).toISOString().split('T')[0] %></p>

                    <p>
                        <strong>Status:</strong>
                        <span class="status-badge status-<%= app.status.toLowerCase() %>"><%= app.status %></span>
                    </p>

                    <a href="/jobs/<%= app.job_id %>" class="btn btn-primary">View Job</a>

                    <form action="/applications/withdraw/<%= app.id %>" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Withdraw this application?');">Withdraw</button>
                    </form>
                </div>
            <% }); %>
        </div>
    </div>

</body>
</html>
