<!DOCTYPE html>
<html>
<head>
    <title>My Applications - EventConnect</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>

        <div class="nav-buttons">
            <a href="/" class="nav-btn">Home</a>
            <a href="/dashboard" class="nav-btn">Dashboard</a>
            <a href="/jobs" class="nav-btn">View Jobs</a>
            <a href="/applications" class="nav-btn active-btn">My Applications</a>
            <a href="/logout" class="nav-btn logout-btn">Logout</a>
        </div>
    </nav>

    <div class="dashboard-container">
        <h1>My Applications</h1>

        <p>Here are all the jobs you have applied for and their current status.</p>

        <% if (messages && messages.length > 0) { %>
            <div class="success"><%= messages[0] %></div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
            <div class="error"><%= errors[0] %></div>
        <% } %>

        <% if (applications.length === 0) { %>
            <div class="dashboard-card">
                <p>You haven't applied for any jobs yet.</p>
                <a href="/jobs" class="main-btn">Browse Jobs</a>
            </div>
        <% } %>

        <% applications.forEach(function(app) { %>
            <div class="dashboard-card">
                <h3><%= app.job_title %> &mdash; <%= app.event_name %></h3>

                <p><strong>Location:</strong> <%= app.location %></p>
                <p><strong>Event Date:</strong> <%= new Date(app.event_date).toISOString().split('T')[0] %></p>
                <p><strong>Applied On:</strong> <%= new Date(app.applied_at).toISOString().split('T')[0] %></p>

                <p>
                    <strong>Status:</strong>
                    <span class="status-badge status-<%= app.status.toLowerCase() %>"><%= app.status %></span>
                </p>

                <a href="/jobs/<%= app.job_id %>" class="main-btn">View Job</a>

                <form action="/applications/withdraw/<%= app.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="secondary-btn" onclick="return confirm('Withdraw this application?');">Withdraw</button>
                </form>
            </div>
        <% }); %>
    </div>

</body>
</html>
