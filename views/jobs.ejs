<!DOCTYPE html>
<html>
<head>
    <title>Job Listings - EventConnect</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>

        <div class="nav-buttons">
            <a href="/" class="nav-btn">Home</a>
            <a href="/dashboard" class="nav-btn">Dashboard</a>
            <a href="/jobs" class="nav-btn active-btn">View Jobs</a>
            <% if (user.role === 'admin') { %>
                <a href="/jobs/add" class="nav-btn">Create Job</a>
            <% } %>
            <a href="/logout" class="nav-btn logout-btn">Logout</a>
        </div>
    </nav>

    <div class="dashboard-container">
        <h1>Event Job Listings</h1>

        <% if (messages && messages.length > 0) { %>
            <div class="success"><%= messages[0] %></div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
            <div class="error"><%= errors[0] %></div>
        <% } %>

        <% if (jobs.length === 0) { %>
            <div class="dashboard-card">
                <p>No jobs have been posted yet.</p>
            </div>
        <% } %>

        <% jobs.forEach(function(job) { %>
            <div class="dashboard-card">
                <h3><%= job.job_title %> &mdash; <%= job.event_name %></h3>

                <a href="/jobs/<%= job.id %>" class="main-btn">View Details</a>

                <p><%= job.description %></p>

                <p><strong>Location:</strong> <%= job.location %></p>
                <p><strong>Event Date:</strong> <%= new Date(job.event_date).toISOString().split('T')[0] %></p>
                <p><strong>Working Hours:</strong> <%= job.working_hours %></p>
                <p><strong>Salary:</strong> $<%= job.salary %></p>
                <p><strong>Workers Required:</strong> <%= job.workers_required %></p>

                <% if (user.role === 'admin') { %>
                    <a href="/jobs/edit/<%= job.id %>" class="main-btn">Edit</a>
                    <form action="/jobs/delete/<%= job.id %>" method="POST" style="display:inline;">
                        <button type="submit" class="secondary-btn" onclick="return confirm('Delete this job posting?');">Delete</button>
                    </form>
                <% } else if (user.role === 'user') { %>
                    <% if (acceptedJobIds.includes(job.id)) { %>
                        <span class="success" style="display:inline-block; margin-top:15px;">✓ Accepted</span>
                    <% } else { %>
                        <form action="/jobs/accept/<%= job.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="main-btn">Accept Job</button>
                        </form>
                    <% } %>
                <% } %>
            </div>
        <% }); %>
    </div>

</body>
</html>
