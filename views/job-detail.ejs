<!DOCTYPE html>
<html>
<head>
    <title>Job Details - EventConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>

        <div class="nav-buttons">
            <a href="/">Home</a>
            <a href="/dashboard">Dashboard</a>
            <a href="/jobs">View Jobs</a>
            <% if (user.role === 'admin') { %>
                <a href="/jobs/add">Create Job</a>
            <% } %>
            <% if (user.role === 'user') { %>
                <a href="/applications">My Applications</a>
            <% } else if (user.role === 'admin') { %>
                <a href="/applications/manage">Manage Applications</a>
            <% } %>
            <% if (user && user.role === 'user') { %>
                <a href="/favourites" class="nav-btn active-btn">My Favourites</a>
            <% } %>
            <a href="/profile" class="nav-btn active-btn">My Profile</a>
            <% if (user && user.role === 'admin') { %>
            <a href="/profile/management" class="nav-btn">View Management</a>
            <% } %>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>
    </nav>

    <div class="dashboard-container">

        <% if (errors && errors.length > 0) { %>
            <div class="error"><%= errors[0] %></div>
        <% } %>

        <div class="card-grid">
            <div class="dashboard-card">
                <h1><%= job.job_title %> &mdash; <%= job.event_name %></h1>

                <p><%= job.description %></p>

                <p><strong>Location:</strong> <%= job.location %></p>
                <p><strong>Event Date:</strong> <%= new Date(job.event_date).toISOString().split('T')[0] %></p>
                <p><strong>Working Hours:</strong> <%= job.working_hours %></p>
                <p><strong>Salary:</strong> $<%= job.salary %></p>
                <p><strong>Workers Required:</strong> <%= job.workers_required %></p>
            </div>

            <div class="dashboard-card">
                <h3>Employer Information</h3>
                <p><strong>Employer:</strong> <%= job.employer_name %></p>
                <p><strong>Contact Email:</strong> <%= job.employer_email %></p>

                <h4>Employer Ratings</h4>
                <p>No ratings available yet.</p>
            </div>
        </div>

        <% if (user.role === 'user') { %>
            <form action="/applications/apply/<%= job.id %>" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-primary">Apply for this Job</button>
            </form>
        <% } %>

        <a href="/jobs" class="btn btn-secondary">&larr; Back to Job Listings</a>
    </div>

</body>
</html>