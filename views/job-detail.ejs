<!DOCTYPE html>
<html>
<head>
    <title>Job Details - EventConnect</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>

        <div class="nav-buttons">
            <a href="/" class="nav-btn">Home</a>
            <a href="/dashboard" class="nav-btn">Dashboard</a>
            <a href="/jobs" class="nav-btn active-btn">View Jobs</a>
            <% if (user.role === 'admin') { %>
                <a href="/jobs/add" class="nav-btn">Create Job</a>
            <% } %>
            <a href="/logout" class="nav-btn logout-btn">Logout</a>
        </div>
    </nav>

    <div class="dashboard-container">

        <% if (errors && errors.length > 0) { %>
            <div class="error"><%= errors[0] %></div>
        <% } %>

        <div class="dashboard-card">
            <h1><%= job.job_title %> &mdash; <%= job.event_name %></h1>

            <p><%= job.description %></p>

            <p><strong>Location:</strong> <%= job.location %></p>
            <p><strong>Event Date:</strong> <%= new Date(job.event_date).toISOString().split('T')[0] %></p>
            <p><strong>Working Hours:</strong> <%= job.working_hours %></p>
            <p><strong>Salary:</strong> $<%= job.salary %></p>
            <p><strong>Workers Required:</strong> <%= job.workers_required %></p>
        </div>

        <div class="dashboard-card">
            <h3>Employer Information</h3>
            <p><strong>Employer:</strong> <%= job.employer_name %></p>
            <p><strong>Contact Email:</strong> <%= job.employer_email %></p>

            <h4>Employer Ratings</h4>
            <p>No ratings available yet.</p>
        </div>

        <a href="/jobs" class="main-btn">&larr; Back to Job Listings</a>
    </div>

</body>
</html>