<!DOCTYPE html>
<html>
<head>
    <title>Create Job - EventConnect</title>    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>

        <div class="nav-buttons">
            <a href="/">Home</a>
            <a href="/dashboard">Dashboard</a>
            <a href="/jobs">View Jobs</a>
            <% if (user.role === 'admin') { %>
                <a href="/jobs/add">Create Job</a>
            <% } %>
            <% if (user.role === 'user') { %>
                <a href="/applications">My Applications</a>
            <% } else if (user.role === 'admin') { %>
                <a href="/applications/manage">Manage Applications</a>
            <% } %>
            <% if (user && user.role === 'user') { %>
                <a href="/favourites" class="nav-btn active-btn">My Favourites</a>
            <% } %>            <a href="/profile" class="nav-btn active-btn">My Profile</a>
            <% if (user && user.role === 'admin') { %>
            <a href="/profile/management" class="nav-btn">View Management</a>
            <% } %>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>
    </nav>

    <div class="login-container">
        <h1>Create Job</h1>

        <p>Add a new event job posting for workers to find on EventConnect.</p>

        <% if (errors && errors.length > 0) { %>
            <div class="error">
                <% errors.forEach(function(message) { %>
                    <p><%= message %></p>
                <% }); %>
            </div>
        <% } %>

        <form action="/jobs/add" method="POST">
            <label for="job_title">Job Title</label>
            <input
                type="text"
                id="job_title"
                name="job_title"
                placeholder="e.g. Event Usher"
                required
                value="<%= formData && formData.job_title ? formData.job_title : '' %>"
            >

            <label for="event_name">Event Name</label>
            <input
                type="text"
                id="event_name"
                name="event_name"
                placeholder="e.g. Singapore Food Festival"
                required
                value="<%= formData && formData.event_name ? formData.event_name : '' %>"
            >

            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="4"
                placeholder="Describe the role, duties and requirements"
                required
            ><%= formData && formData.description ? formData.description : '' %></textarea>

            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                placeholder="e.g. Marina Bay Sands"
                required
                value="<%= formData && formData.location ? formData.location : '' %>"
            >

            <label for="salary">Salary (SGD)</label>
            <input
                type="number"
                step="0.01"
                min="0.01"
                id="salary"
                name="salary"
                placeholder="e.g. 120.00"
                required
                value="<%= formData && formData.salary ? formData.salary : '' %>"
            >

            <label for="event_date">Event Date</label>
            <input
                type="date"
                id="event_date"
                name="event_date"
                required
                value="<%= formData && formData.event_date ? formData.event_date : '' %>"
            >

            <label for="working_hours">Working Hours</label>
            <input
                type="text"
                id="working_hours"
                name="working_hours"
                placeholder="e.g. 9am - 5pm"
                required
                value="<%= formData && formData.working_hours ? formData.working_hours : '' %>"
            >

            <label for="workers_required">Number of Workers Required</label>
            <input
                type="number"
                step="1"
                min="1"
                id="workers_required"
                name="workers_required"
                placeholder="e.g. 5"
                required
                value="<%= formData && formData.workers_required ? formData.workers_required : '' %>"
            >

            <button type="submit">Create Job</button>
        </form>

        <p class="small-text">
            Changed your mind?
            <a href="/dashboard">Back to Dashboard</a>
        </p>
    </div>

</body>
</html>
