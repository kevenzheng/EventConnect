<!DOCTYPE html>
<html>
<head>
    <title>Register - EventConnect</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>

        <div class="nav-buttons">
            <a href="/">Home</a>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        </div>
    </nav>

    <div class="login-container">
        <h1>Register</h1>

        <p>Create your EventConnect account.</p>

        <% if (messages && messages.length > 0) { %>
            <div class="error">
                <% messages.forEach(function(message) { %>
                    <p><%= message %></p>
                <% }); %>
            </div>
        <% } %>

        <form action="/register" method="POST">
            <label for="username">Username</label>
            <input 
                type="text" 
                id="username" 
                name="username" 
                required
                value="<%= formData && formData.username ? formData.username : '' %>"
            >

            <label for="email">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                required
                value="<%= formData && formData.email ? formData.email : '' %>"
            >

            <label for="password">Password</label>
            <input 
                type="password" 
                id="password" 
                name="password" 
                required
            >

            <label for="address">Address</label>
            <input 
                type="text" 
                id="address" 
                name="address" 
                required
                value="<%= formData && formData.address ? formData.address : '' %>"
            >

            <label for="contact">Contact Number</label>
            <input 
                type="text" 
                id="contact" 
                name="contact" 
                required
                value="<%= formData && formData.contact ? formData.contact : '' %>"
            >

            <label for="role">Role</label>
            <select id="role" name="role" required>
                <option value="user" <%= formData && formData.role === 'user' ? 'selected' : '' %>>
                    User
                </option>
                <option value="admin" <%= formData && formData.role === 'admin' ? 'selected' : '' %>>
                    Admin
                </option>
            </select>

            <button type="submit">Register</button>
        </form>

        <p class="small-text">
            Already have an account?
            <a href="/login">Login here</a>
        </p>
    </div>

</body>
</html>