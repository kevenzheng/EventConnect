<!DOCTYPE html>
<html>
<head>
    <title>Register - EventConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>EventConnect</h2>

        <div class="nav-buttons">
            <a href="/">Home</a>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        </div>
    </nav>

    <div class="login-container">
        <h1>Register</h1>

        <p>Create your EventConnect account.</p>

        <% if (messages && messages.length > 0) { %>
            <div class="error">
                <% messages.forEach(function(message) { %>
                    <p><%= message %></p>
                <% }); %>
            </div>
        <% } %>

        <!-- =================================================
             MULTI-STEP REGISTER FLOW
             ================================================= -->
        <form id="registerForm" action="/register" method="POST">

            <!-- STEP 1: ROLE SELECTION -->
            <div id="step-role" class="reg-step">
                <label>I am registering as...</label>
                <div class="role-choice">
                    <button type="button" class="role-card" data-role="user">
                        <span class="role-card-title">User</span>
                        <span class="role-card-desc">Looking for event work</span>
                    </button>
                    <button type="button" class="role-card" data-role="admin">
                        <span class="role-card-title">Admin</span>
                        <span class="role-card-desc">Posting event jobs</span>
                    </button>
                </div>
            </div>

            <!-- STEP 2: ADMIN SECRET KEY (admin path only) -->
            <div id="step-admin-key" class="reg-step" style="display:none;">
                <p class="step-back" data-back="step-role">&larr; Change role</p>

                <label for="adminKey">Admin Secret Key</label>
                <input
                    type="password"
                    id="adminKey"
                    name="adminKey"
                    placeholder="Enter the admin secret key"
                >
                <p class="field-hint">Ask your system administrator for this key.</p>
                <p id="adminKeyError" class="field-error" style="display:none;">Invalid admin secret key.</p>

                <button type="button" id="verifyAdminKeyBtn" class="btn btn-secondary" style="margin-top:16px;">
                    Verify &amp; Continue
                </button>
            </div>

            <!-- STEP 3: ACCOUNT INFO -->
            <div id="step-info" class="reg-step" style="display:none;">
                <p class="step-back" id="infoBackLink">&larr; Back</p>

                <input type="hidden" id="role" name="role" value="<%= formData && formData.role ? formData.role : '' %>">

                <label for="username">Username</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    value="<%= formData && formData.username ? formData.username : '' %>"
                >

                <label for="email">Email</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= formData && formData.email ? formData.email : '' %>"
                >

                <label for="password">Password</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                >

                <div id="addressGroup" style="display:none;">
                    <label for="address">Address</label>
                    <input
                        type="text"
                        id="address"
                        name="address"
                        value="<%= formData && formData.address ? formData.address : '' %>"
                    >
                </div>

                <label for="contact">Contact Number</label>
                <input
                    type="text"
                    id="contact"
                    name="contact"
                    value="<%= formData && formData.contact ? formData.contact : '' %>"
                >

                <button type="submit">Register</button>
            </div>
        </form>

        <p class="small-text">
            Already have an account?
            <a href="/login">Login here</a>
        </p>
    </div>

    <script>
        // Pre-fill data from a failed submit (req.flash formData), sent from the server.
        const previousFormData = <%- JSON.stringify(formData || {}) %>;

        const stepRole = document.getElementById('step-role');
        const stepAdminKey = document.getElementById('step-admin-key');
        const stepInfo = document.getElementById('step-info');

        const roleInput = document.getElementById('role');
        const adminKeyInput = document.getElementById('adminKey');
        const adminKeyError = document.getElementById('adminKeyError');
        const addressGroup = document.getElementById('addressGroup');
        const addressInput = document.getElementById('address');
        const infoBackLink = document.getElementById('infoBackLink');

        function showStep(step) {
            [stepRole, stepAdminKey, stepInfo].forEach(s => s.style.display = 'none');
            step.style.display = 'block';
        }

        // Address is only collected for Admin (employer) accounts.
        function applyRoleToInfoStep(role) {
            roleInput.value = role;
            if (role === 'admin') {
                addressGroup.style.display = 'block';
                addressInput.setAttribute('required', 'required');
                infoBackLink.setAttribute('data-back', 'step-admin-key');
            } else {
                addressGroup.style.display = 'none';
                addressInput.removeAttribute('required');
                addressInput.value = '';
                infoBackLink.setAttribute('data-back', 'step-role');
            }
        }

        // STEP 1 -> role card clicked
        document.querySelectorAll('.role-card').forEach(function (card) {
            card.addEventListener('click', function () {
                const role = card.getAttribute('data-role');
                if (role === 'admin') {
                    adminKeyInput.value = '';
                    adminKeyError.style.display = 'none';
                    showStep(stepAdminKey);
                } else {
                    applyRoleToInfoStep('user');
                    showStep(stepInfo);
                }
            });
        });

        // STEP 2 -> verify admin secret key live, only move on if it's correct
        document.getElementById('verifyAdminKeyBtn').addEventListener('click', function () {
            const key = adminKeyInput.value;
            adminKeyError.style.display = 'none';

            fetch('/register/verify-admin-key', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ adminKey: key })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        applyRoleToInfoStep('admin');
                        showStep(stepInfo);
                    } else {
                        adminKeyError.style.display = 'block';
                    }
                })
                .catch(function () {
                    adminKeyError.textContent = 'Could not verify the key right now. Please try again.';
                    adminKeyError.style.display = 'block';
                });
        });

        // Back links
        document.querySelectorAll('.step-back').forEach(function (el) {
            el.addEventListener('click', function () {
                const targetId = el.getAttribute('data-back');
                showStep(document.getElementById(targetId));
            });
        });
        infoBackLink.addEventListener('click', function () {
            const targetId = infoBackLink.getAttribute('data-back');
            showStep(document.getElementById(targetId));
        });

        if (previousFormData && previousFormData.role === 'user') {
            applyRoleToInfoStep('user');
            showStep(stepInfo);
        } else if (previousFormData && previousFormData.role === 'admin') {
            showStep(stepAdminKey);
        } else {
            showStep(stepRole);
        }
    </script>

</body>
</html>
